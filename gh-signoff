#!/usr/bin/env bash
set -euo pipefail
# set -x # Keep this commented out unless actively debugging

DEBUG=${SIGNOFF_DEBUG:-}
readonly VERSION="0.4.0"

# Status symbols for consistent display - export them for both script and tests
export STATUS_SUCCESS="✓"
export STATUS_PENDING="⟳"
export STATUS_FAILURE="✗"

# Catches failures the script didn't anticipate. Commands report an expected
# negative result (e.g. check on an unprotected branch) by exiting nonzero
# themselves: returning nonzero would reach this trap and look unexpected.
trap 'fail "Unexpected error on line $LINENO ($?)"' ERR

if ! command -v git >/dev/null 2>&1; then
  echo "Error: git command not found" >&2
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "Error: gh command not found. Please install GitHub CLI: https://cli.github.com" >&2
  exit 1
fi

# Cache for default branch
DEFAULT_BRANCH=""

# Reason the working tree failed is_clean, for error reporting
UNCLEAN_REASON=""

# Tip SHA url_remote_tip proved, for is_clean to check HEAD against
URL_REMOTE_TIP=""

# Results of the last resolve_commit call
RESOLVED_COMMIT=""
RESOLVED_COMMIT_IS_LOCAL=true

debug() {
  if [[ -n "$DEBUG" ]]; then
    echo "Debug: $*" >&2
  fi
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

reject_extra_args() {
  if [[ $# -gt 0 ]]; then
    fail "unexpected argument: $1"
  fi
}

# Expand a revision — a short sha, a tag, a branch, HEAD~1 — to the full sha
# of the commit it names. Reports via RESOLVED_COMMIT and, since a sha we
# have no object for can't be checked against a remote, RESOLVED_COMMIT_IS_LOCAL.
resolve_commit() {
  local rev="$1"

  if [[ -z "$rev" || "$rev" == -* ]]; then
    fail "option --commit requires an argument"
  fi

  RESOLVED_COMMIT=$(git rev-parse --verify --quiet "${rev}^{commit}" 2>/dev/null) || RESOLVED_COMMIT=""

  if [[ -n "$RESOLVED_COMMIT" ]]; then
    RESOLVED_COMMIT_IS_LOCAL=true
    return
  fi

  # We have the object but it doesn't peel to a commit: a tree or a blob
  if git cat-file -e "$rev" 2>/dev/null; then
    fail "not a commit: $rev"
  fi

  # Unknown to git. A full sha may still name a commit we haven't fetched;
  # anything shorter or non-hex is a typo, not a revision.
  [[ "$rev" =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit: $rev"
  RESOLVED_COMMIT="$rev"
  RESOLVED_COMMIT_IS_LOCAL=false
}

# Is the commit on a remote we know about? Remote-tracking refs are only as
# fresh as the last fetch, so this is a local proxy; -f overrides.
commit_is_on_a_remote() {
  if [[ -n "$(git branch -r --contains "$1" 2>/dev/null)" ]]; then
    return 0
  fi

  # A branch checked out from a fork pull request tracks a bare URL, which has
  # no remote-tracking refs for `git branch -r` to search at all. Ask that
  # remote for its tip the way is_clean does, and reuse the same inference: a
  # commit contained in the tip is on that remote too. Without this,
  # `gh signoff --commit HEAD` would refuse the very commit plain
  # `gh signoff` just proved was published.
  url_remote_tip || return 1
  git merge-base --is-ancestor "$1" "$URL_REMOTE_TIP" 2>/dev/null
}

# Get default branch with caching
#
# Two conventions apply to every gh call below. Filtering uses gh's built-in
# --jq rather than an external jq: gh is the only dependency this script checks
# for at startup, and being Go it never translates line endings the way jq does
# on Windows. Captures still get their CRs stripped anyway, since we can't test
# Windows from here and a stray \r matches nothing. And gh prints API error
# bodies to stdout, so every failure path has to reset its capture rather than
# leave {"message":"Not Found"} looking like a response.
default_branch() {
  if [[ -z "$DEFAULT_BRANCH" ]]; then
    DEFAULT_BRANCH=$(gh api repos/:owner/:repo --jq .default_branch 2>/dev/null) || {
      DEFAULT_BRANCH=""
      return 1
    }
    DEFAULT_BRANCH=${DEFAULT_BRANCH//$'\r'/}
  fi
  echo "$DEFAULT_BRANCH"
}

# Populate the DEFAULT_BRANCH cache in this shell, or die. A
# $(default_branch) capture caches only inside its subshell, so ruleset
# identity — which hinges on whether the branch is the default — would
# re-resolve per call and could flip mid-command on a transient API failure,
# misnaming the ruleset. Writers call this up front and fail rather than
# guess; readers warm the cache tolerantly and degrade to "none found".
require_default_branch() {
  default_branch >/dev/null || fail "failed to get default branch"
}

# --- Rulesets ---
#
# Signoff requirements live in a repository ruleset that this extension owns
# outright: exactly one per branch, named deterministically from the branch,
# created by install, tweaked only by install/uninstall, deleted by a bare
# uninstall. Other rulesets — the repo's, the org's — layer alongside and are
# none of our business in either direction. The only reason to list rulesets
# at all is to find our own id by name, because the API has no upsert.
#
# Repos protected by an older gh-signoff carry legacy branch protection
# instead. Reads merge its signoff contexts in so they keep working, and
# install migrates it: the union of both worlds lands in the ruleset, then
# the legacy protection is deleted when it holds nothing but what old
# gh-signoff installs wrote.

# Results of the last find_signoff_ruleset_id call (empty = no ruleset)
SIGNOFF_RULESET_ID=""

# Results of the last fetch_required_signoff_contexts call
SIGNOFF_CONTEXTS=""
SIGNOFF_LEGACY_PRESENT=false

# Results of the last legacy_protection_disposition call
LEGACY_PROTECTION="none"
LEGACY_SIGNOFF_CONTEXTS=""

# Results of the last merge_contexts call
MERGED_CONTEXTS=""

# The default branch's ruleset is named plain 'signoff' and targets
# ~DEFAULT_BRANCH, so it survives a default-branch rename. Any other branch
# gets its name in the ruleset name and an explicit ref.
signoff_ruleset_name() {
  local branch="$1"
  if [[ "$branch" == "$(default_branch)" ]]; then
    echo "signoff"
  else
    echo "signoff (${branch})"
  fi
}

signoff_ruleset_ref() {
  local branch="$1"
  if [[ "$branch" == "$(default_branch)" ]]; then
    echo "~DEFAULT_BRANCH"
  else
    echo "refs/heads/${branch}"
  fi
}

# Find our ruleset by its deterministic name, reporting via SIGNOFF_RULESET_ID
# (empty = none). The list endpoint answers 200 [] when no rulesets exist, so
# "none" is an empty id, not an error; nonzero means the API call itself
# failed, which writers treat as fatal and readers as "none".
#
# includes_parents=false keeps org-level rulesets out: the list includes them
# by default, and an org policy that happens to be named "signoff" is another
# tenant's artifact, not ours to read or write. targets=branch likewise
# excludes tag and push rulesets. Within this repo's branch rulesets, though,
# the name IS the identity claim: a repo admin who creates a ruleset named
# exactly "signoff" is claiming signoff semantics, and install adopting it
# (union its contexts, normalize its shape) is the intended behavior, not a
# collision to defend against. If two somehow share the name, first match
# wins and only that one is ever touched.
find_signoff_ruleset_id() {
  local branch="$1" name rows id rname
  SIGNOFF_RULESET_ID=""

  name=$(signoff_ruleset_name "$branch")
  rows=$(gh api "repos/:owner/:repo/rulesets?includes_parents=false&targets=branch" --paginate \
    --jq '.[] | [.id, .name] | @tsv' 2>/dev/null) || return 1
  rows=${rows//$'\r'/}

  while IFS=$'\t' read -r id rname; do
    if [[ "$rname" == "$name" && -z "$SIGNOFF_RULESET_ID" ]]; then
      SIGNOFF_RULESET_ID="$id"
    fi
  done <<<"$rows"
}

# The contexts a ruleset requires, one per line on stdout. Nonzero on API
# failure: readers may shrug that off as empty, but writers must treat it as
# fatal — computing a union or remainder from contexts that merely failed to
# load would silently drop requirements.
signoff_ruleset_contexts() {
  local id="$1" contexts
  contexts=$(gh api "repos/:owner/:repo/rulesets/${id}" \
    --jq '.rules[]? | select(.type == "required_status_checks") | .parameters.required_status_checks[].context' \
    2>/dev/null) || return 1
  echo "${contexts//$'\r'/}"
}

# The one definition of "a legacy status check that is ours": named exactly
# 'signoff' or 'signoff/…' — the only names this tool has ever written — and
# bound to no particular GitHub App, because old installs never bound one.
# A 'signoff-security' context or a signoff check pinned to an app_id is
# someone else's configuration: never claimed, migrated, removed, or counted
# by reads. Reads from `checks` (the modern view carrying app identity),
# normalizing the deprecated `contexts` list when a response has only that.
LEGACY_CHECKS='(.required_status_checks.checks // [.required_status_checks.contexts[]? | {context: ., app_id: null}])[]?'
LEGACY_CHECK_IS_OURS='((.context == "signoff" or (.context | startswith("signoff/"))) and (.app_id == null or .app_id == -1))'

# The branch's legacy signoff contexts, one per line on stdout. A 404 (no
# protection) reads as empty, matching the old unprotected signal.
legacy_signoff_contexts() {
  local branch="$1" contexts
  contexts=$(gh api "repos/:owner/:repo/branches/${branch}/protection" \
    --jq "${LEGACY_CHECKS} | select(${LEGACY_CHECK_IS_OURS}) | .context" \
    2>/dev/null) || contexts=""
  echo "${contexts//$'\r'/}"
}

# Merge newline-separated context lists, preserving order and dropping blanks
# and duplicates. Reports via MERGED_CONTEXTS. Membership is the whole-line
# substring check used throughout; Bash 3 has no associative arrays.
merge_contexts() {
  local list line
  MERGED_CONTEXTS=""
  for list in "$@"; do
    while read -r line; do
      [[ -n "$line" ]] || continue
      if [[ $'\n'"$MERGED_CONTEXTS"$'\n' != *$'\n'"${line}"$'\n'* ]]; then
        MERGED_CONTEXTS="${MERGED_CONTEXTS:+$MERGED_CONTEXTS$'\n'}$line"
      fi
    done <<<"$list"
  done
}

# Every signoff context the branch requires: our ruleset's, merged with any
# legacy branch protection still in place. Reports via SIGNOFF_CONTEXTS (one
# per line) and SIGNOFF_LEGACY_PRESENT rather than stdout — a $(...) capture
# would strand the flag in a subshell (the RESOLVED_COMMIT pattern). API
# failures read as "none", matching the old 404 handling.
fetch_required_signoff_contexts() {
  local branch="$1" ruleset_contexts legacy ctx
  SIGNOFF_CONTEXTS=""
  SIGNOFF_LEGACY_PRESENT=false

  # Warm the default-branch cache in this shell so the identity lookups below
  # resolve consistently and without refetching; when it's unavailable, the
  # ruleset simply won't be found, matching how reads treat API failures
  default_branch >/dev/null 2>&1 || true

  ruleset_contexts=""
  if find_signoff_ruleset_id "$branch" && [[ -n "$SIGNOFF_RULESET_ID" ]]; then
    ruleset_contexts=$(signoff_ruleset_contexts "$SIGNOFF_RULESET_ID") || ruleset_contexts=""
  fi

  legacy=$(legacy_signoff_contexts "$branch")
  if [[ -n "$legacy" ]]; then
    SIGNOFF_LEGACY_PRESENT=true
  fi

  merge_contexts "$ruleset_contexts" "$legacy"
  SIGNOFF_CONTEXTS="$MERGED_CONTEXTS"
}

# One-line nudge for repos still carrying legacy signoff branch protection
legacy_upgrade_hint() {
  echo "Note: signoff is enforced via legacy branch protection; run 'gh signoff install' to migrate it to a ruleset" >&2
}

# The ruleset payload is assembled as a JSON string. Rather than escape
# arbitrary input, refuse the few characters that would break out of a JSON
# string literal — none are plausible in a branch or context name.
require_json_safe() {
  local what="$1" value="$2"
  case "$value" in
    *[\"\\]* | *$'\n'* | *$'\t'*)
      fail "${what} contains characters unsafe for JSON: ${value}"
      ;;
  esac
}

# bypass_actors grants repository admins an always-on bypass, preserving the
# legacy enforce_admins=null semantics: actor_id 5 is the Admin repository
# role, per GitHub's own UI-exported rulesets.
#
# deletion and non_fast_forward ride along with the status checks because
# legacy branch protection blocked branch deletion and force pushes by
# default — every 0.3.0 install had that side effect, so a ruleset without
# these rules would quietly weaken a migrated (or fresh) install.
build_signoff_ruleset_json() {
  local branch="$1"
  shift
  local name ref checks="" context

  require_json_safe "branch name" "$branch"
  name=$(signoff_ruleset_name "$branch")
  ref=$(signoff_ruleset_ref "$branch")

  for context in "$@"; do
    require_json_safe "context name" "$context"
    checks="${checks:+$checks,}{\"context\":\"${context}\"}"
  done

  printf '%s' "{\"name\":\"${name}\",\"target\":\"branch\",\"enforcement\":\"active\",\"bypass_actors\":[{\"actor_id\":5,\"actor_type\":\"RepositoryRole\",\"bypass_mode\":\"always\"}],\"conditions\":{\"ref_name\":{\"include\":[\"${ref}\"],\"exclude\":[]}},\"rules\":[{\"type\":\"deletion\"},{\"type\":\"non_fast_forward\"},{\"type\":\"required_status_checks\",\"parameters\":{\"strict_required_status_checks_policy\":false,\"required_status_checks\":[${checks}]}}]}"
}

# Create (no id) or update (id) our ruleset to require exactly the given
# contexts. gh prints the API error body to stdout; forward it to stderr on
# failure so a plan-tier or permission error is diagnosable.
write_signoff_ruleset() {
  local branch="$1" id="$2"
  shift 2
  local json response

  json=$(build_signoff_ruleset_json "$branch" "$@")
  debug "writing signoff ruleset for ${branch}: ${json}"

  if [[ -n "$id" ]]; then
    response=$(printf '%s' "$json" | gh api "repos/:owner/:repo/rulesets/${id}" \
      --method PUT \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      --input - 2>/dev/null) || {
      if [[ -n "$response" ]]; then echo "$response" >&2; fi
      fail "failed to update signoff ruleset"
    }
  else
    response=$(printf '%s' "$json" | gh api "repos/:owner/:repo/rulesets" \
      --method POST \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      --input - 2>/dev/null) || {
      if [[ -n "$response" ]]; then echo "$response" >&2; fi
      fail "failed to create signoff ruleset"
    }
  fi
}

delete_signoff_ruleset() {
  local id="$1" response
  response=$(gh api --method DELETE "repos/:owner/:repo/rulesets/${id}" 2>/dev/null) || {
    if [[ -n "$response" ]]; then echo "$response" >&2; fi
    fail "failed to remove signoff ruleset"
  }
}

# Classify the branch's legacy branch protection via LEGACY_PROTECTION:
#   none    — confirmed no protection (the API 404s)
#   signoff — exactly what old gh-signoff install wrote: at least one
#             signoff check that is ours (see LEGACY_CHECK_IS_OURS) and
#             nothing else — no other checks, strict false, no reviews, no
#             restrictions, and no enabled flag anywhere, since old installs
#             left enforce_admins, linear history, signatures, and every
#             other {enabled} toggle at their false defaults. Safe to delete
#             wholesale. An otherwise-empty protection is NOT ours: it still
#             blocks force pushes and deletions, and this tool never wrote a
#             protection without a signoff check.
#   other   — someone else's configuration, never deleted wholesale
# LEGACY_SIGNOFF_CONTEXTS collects our signoff contexts either way. One API
# call: the first line summarizes the shape, the rest are the contexts.
#
# The enabled-flag sweep is recursive ([.. | objects]) rather than a field
# list, so a protection feature GitHub adds later reads as "other" instead of
# silently passing as ours.
#
# Nonzero only on a non-404 failure: "no protection" is an answer, but a
# 403/500/timeout is not, and a writer acting on it could migrate from or
# delete protection it never actually saw. gh prints the API error body to
# stdout, so the captured response distinguishes the two.
legacy_protection_disposition() {
  local branch="$1" response summary non_signoff strict flags reviews restrictions
  LEGACY_PROTECTION="none"
  LEGACY_SIGNOFF_CONTEXTS=""

  response=$(gh api "repos/:owner/:repo/branches/${branch}/protection" \
    --jq "([([${LEGACY_CHECKS} | select(${LEGACY_CHECK_IS_OURS} | not)] | length), (.required_status_checks.strict // false), ([.. | objects | select(has(\"enabled\")) | .enabled] | any), (.required_pull_request_reviews != null), (.restrictions != null)] | @tsv), (${LEGACY_CHECKS} | select(${LEGACY_CHECK_IS_OURS}) | .context)" \
    2>/dev/null) || {
    if [[ "$response" == *'"status":"404"'* ]]; then
      return 0
    fi
    return 1
  }
  response=${response//$'\r'/}

  summary="${response%%$'\n'*}"
  if [[ "$response" == *$'\n'* ]]; then
    LEGACY_SIGNOFF_CONTEXTS="${response#*$'\n'}"
  fi

  IFS=$'\t' read -r non_signoff strict flags reviews restrictions <<<"$summary"
  if [[ -n "$LEGACY_SIGNOFF_CONTEXTS" && "$non_signoff" == "0" && "$strict" == "false" &&
    "$flags" == "false" && "$reviews" == "false" && "$restrictions" == "false" ]]; then
    LEGACY_PROTECTION="signoff"
  else
    LEGACY_PROTECTION="other"
  fi
}

# Surgically remove LEGACY_SIGNOFF_CONTEXTS from the branch's protection via
# the remove-status-check-contexts endpoint, leaving every other protection
# setting untouched. Nonzero when they could not be removed.
remove_legacy_signoff_contexts() {
  local branch="$1" json="" ctx response

  while read -r ctx; do
    [[ -n "$ctx" ]] || continue
    # These came back from the API, but serialize defensively: a context this
    # tool would refuse to install can't be removed by this JSON either
    case "$ctx" in
      *[\"\\]* | *$'\t'*) return 1 ;;
    esac
    json="${json:+$json,}\"${ctx}\""
  done <<<"$LEGACY_SIGNOFF_CONTEXTS"
  [[ -n "$json" ]] || return 0

  response=$(printf '{"contexts":[%s]}' "$json" | gh api \
    "repos/:owner/:repo/branches/${branch}/protection/required_status_checks/contexts" \
    --method DELETE \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    --input - 2>/dev/null) || {
    if [[ -n "$response" ]]; then echo "$response" >&2; fi
    return 1
  }
}

# Retire what legacy protection required for signoff: signoff-shaped
# protection is wholly ours and is deleted; protection carrying anything
# else keeps every other setting, with only the signoff contexts surgically
# removed. Nonzero when any of that failed — install may shrug it off (the
# ruleset already enforces the contexts, so a leftover is a harmless
# duplicate), but uninstall must fail rather than report signoff removed
# while legacy protection still enforces it.
retire_legacy_signoff() {
  local branch="$1"
  case "$LEGACY_PROTECTION" in
    signoff)
      gh api --method DELETE "repos/:owner/:repo/branches/${branch}/protection" >/dev/null 2>&1
      ;;
    other)
      remove_legacy_signoff_contexts "$branch"
      ;;
  esac
}

# Get required signoff contexts, stripping the 'signoff/' prefix. The bare
# 'signoff' context has no display name, so it is dropped. Feeds compgen: no
# upgrade hint here.
get_signoff_contexts() {
  local branch="${1:-}" ctx

  # If branch not specified, use default branch
  if [[ -z "$branch" ]]; then
    branch=$(default_branch) || return 0
  fi

  fetch_required_signoff_contexts "$branch"

  while read -r ctx; do
    if [[ "$ctx" == signoff/* ]]; then
      echo "${ctx#signoff/}"
    fi
  done <<<"$SIGNOFF_CONTEXTS"
}

# @{upstream} is a sound stand-in for an unresolvable @{push} only in the
# narrow centralized case: HEAD on a branch whose upstream lives on a real
# remote, effective push.default simple (git's default), and nothing
# rerouting pushes elsewhere. Every other push mode determines its
# destination independently of the upstream — refuse rather than guess at
# git's push-routing rules.
upstream_fallback_is_safe() {
  local branch remote push_default fetch_url push_url
  branch=$(git symbolic-ref --short -q HEAD) || return 1

  push_default=$(git config push.default 2>/dev/null) || push_default="simple"
  [[ "$push_default" == "simple" ]] || return 1

  remote=$(git config "branch.${branch}.remote" 2>/dev/null) || return 1
  [[ "$remote" != "." ]] || return 1

  # Resolved URLs catch pushurl, pushInsteadOf rewrites, and multi-URL
  # remotes: require exactly one fetch URL and one identical push URL
  fetch_url=$(git remote get-url --all "$remote" 2>/dev/null) || return 1
  push_url=$(git remote get-url --push --all "$remote" 2>/dev/null) || return 1
  [[ "$fetch_url" == "$push_url" && "$fetch_url" != *$'\n'* ]] || return 1

  ! git config "branch.${branch}.pushRemote" >/dev/null 2>&1 &&
    ! git config remote.pushDefault >/dev/null 2>&1 &&
    ! git config --get-all "remote.${remote}.push" >/dev/null 2>&1
}

# git accepts either a remote name or a URL wherever a remote is named, so
# branch.<name>.remote may hold either. Distinguish them by enumeration rather
# than by pattern: a value that matches a configured remote is a name, and
# everything else git treats as a URL.
remote_is_named() {
  local remote="$1" name found=1

  while read -r name; do
    if [[ "$name" == "$remote" ]]; then
      found=0
    fi
  done < <(git remote)

  return "$found"
}

# `gh pr checkout` on a cross-repository (fork) pull request creates no named
# remote. It points the branch at a bare URL instead:
#
#   branch.<name>.remote     = https://github.com/someone/gh-signoff.git
#   branch.<name>.pushremote = https://github.com/someone/gh-signoff.git
#   branch.<name>.merge      = refs/heads/<their-branch>
#
# git supports that natively, but a URL-valued remote has no remote-tracking
# ref, so every local check dead-ends: @{push} and @{upstream} both fail with
# "not stored as a remote-tracking branch", and upstream_fallback_is_safe's
# `git remote get-url` errors with "No such remote '<url>'". Reviewing a
# contributor's pull request and signing off on it is a core workflow for this
# tool, so rather than refuse for want of a local ref, ask the remote itself.
#
# `git ls-remote <url> <ref>` advertises that ref's tip SHA. A repository
# holding a commit holds all of its ancestors, and a commit's parents are part
# of the object, so ancestry computed locally is ancestry on the remote too:
# once the tip object is present here, "HEAD is contained in the tip" proves
# HEAD is on that remote. That is precisely the inference is_clean already
# makes about a remote-tracking ref — the tip SHA merely arrives over the wire
# instead of from refs/remotes. When the tip object is absent locally there is
# nothing to reason from: ls-remote yields ref tips, not history, so proving
# containment would mean fetching. Refuse instead.
#
# Which repository we are proving things about still has to be the one a push
# would reach, so the routing allowlist mirrors upstream_fallback_is_safe:
# effective push.default simple, and the effective push remote this same URL.
# Push refspecs need no check here — a [remote "<url>"] config section would
# make the URL a configured remote, which remote_is_named already excludes.
# url.*.pushInsteadOf does need one: it rewrites push URLs, and git offers no
# way to expand the push side of an anonymous remote (`git remote get-url
# --push` insists on a configured remote), so refuse rather than interrogate a
# URL that a push would not use.
#
# Returns 0 with URL_REMOTE_TIP set to the proven tip, 1 with UNCLEAN_REASON
# set when the branch tracks a URL but nothing can be proven about it, and 2
# when the branch does not track a URL at all and the caller's own reason
# should stand.
url_remote_tip() {
  local branch remote merge_ref push_default push_remote advertised sha ref

  branch=$(git symbolic-ref --short -q HEAD) || return 2
  remote=$(git config "branch.${branch}.remote" 2>/dev/null) || return 2
  [[ -n "$remote" && "$remote" != "." ]] || return 2
  ! remote_is_named "$remote" || return 2

  # Past here the branch provably tracks a URL, so failures say so instead of
  # deferring to is_clean's generic "check push.default and branch tracking"
  URL_REMOTE_TIP=""

  merge_ref=$(git config "branch.${branch}.merge" 2>/dev/null) || merge_ref=""
  # git resolves an unqualified merge ref against the remote's heads
  [[ -z "$merge_ref" || "$merge_ref" == refs/* ]] || merge_ref="refs/heads/${merge_ref}"

  push_default=$(git config push.default 2>/dev/null) || push_default="simple"
  push_remote=$(git config "branch.${branch}.pushRemote" 2>/dev/null) ||
    push_remote=$(git config remote.pushDefault 2>/dev/null) ||
    push_remote="$remote"

  if [[ -z "$merge_ref" || "$push_default" != "simple" || "$push_remote" != "$remote" ]] ||
    git config --get-regexp '^url\..*\.pushinsteadof$' >/dev/null 2>&1; then
    debug "branch ${branch} tracks the URL ${remote} but its push destination is not provably that URL"
    UNCLEAN_REASON="cannot verify the current branch is pushed (branch ${branch} tracks ${remote} as a URL, so there is no tracking ref, and its push destination is not provably that URL; add a named remote for it, or -f to override)"
    return 1
  fi

  advertised=$(git ls-remote "$remote" "$merge_ref" 2>/dev/null) || {
    debug "could not reach ${remote} to look up ${merge_ref}"
    UNCLEAN_REASON="cannot verify the current branch is pushed (branch ${branch} tracks ${remote} as a URL, so there is no tracking ref, and that remote could not be reached; -f to override)"
    return 1
  }

  # ls-remote patterns match ref tails, so take the exact ref rather than the
  # first line
  while IFS=$'\t' read -r sha ref; do
    if [[ "$ref" == "$merge_ref" ]]; then
      URL_REMOTE_TIP="$sha"
    fi
  done <<<"$advertised"

  if [[ -z "$URL_REMOTE_TIP" ]]; then
    debug "${merge_ref} is not advertised by ${remote}"
    UNCLEAN_REASON="repository has unpushed changes (${merge_ref} does not exist on ${remote})"
    return 1
  fi

  if ! git cat-file -e "${URL_REMOTE_TIP}^{commit}" 2>/dev/null; then
    debug "${remote} advertises ${merge_ref} at ${URL_REMOTE_TIP}, which is not in this repository"
    UNCLEAN_REASON="cannot verify the current branch is pushed (${remote} has ${merge_ref} at ${URL_REMOTE_TIP}, which is not in this repository; git fetch ${remote} ${merge_ref}, or -f to override)"
    return 1
  fi

  return 0
}

is_clean() {
  local git_cmd=$(command -v git)

  if [[ -n "$($git_cmd status --porcelain)" ]]; then
    debug "found uncommitted changes"
    UNCLEAN_REASON="repository has uncommitted changes"
    return 1
  fi

  # @{push} is authoritative for "are my commits pushed?", but under
  # push.default=simple it only resolves when local and upstream names match.
  # Fall back to @{upstream} — HEAD contained in the upstream is a sound proxy
  # for "this SHA is on the remote" — when that's provably safe.
  local push_ref
  push_ref=$($git_cmd rev-parse --abbrev-ref @{push} 2>/dev/null) || push_ref=""

  if [[ -z "$push_ref" ]]; then
    if upstream_fallback_is_safe; then
      push_ref=$($git_cmd rev-parse --abbrev-ref @{upstream} 2>/dev/null) || push_ref=""
    else
      # Neither ref resolves for a branch tracking a bare URL, which has no
      # remote-tracking ref at all: ask that remote for the tip instead
      local tip_status=0
      url_remote_tip || tip_status=$?
      case "$tip_status" in
        0) push_ref="$URL_REMOTE_TIP" ;;
        1) return 1 ;;
      esac
    fi
  fi

  if [[ -z "$push_ref" ]]; then
    debug "@{push} does not resolve and @{upstream} is not a sound fallback"
    UNCLEAN_REASON="cannot verify the current branch is pushed (@{push} does not resolve; check push.default and branch tracking; -f to override)"
    return 1
  fi

  if [[ -n "$($git_cmd log "$push_ref"..)" ]]; then
    debug "found unpushed changes"
    UNCLEAN_REASON="repository has unpushed changes"
    return 1
  fi

  return 0
}

cmd_create() {
  local force=false
  local commit="" commit_is_local=true
  local contexts=()

  # Process arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f)
        force=true
        shift
        ;;
      --commit)
        resolve_commit "${2:-}"
        commit="$RESOLVED_COMMIT"
        commit_is_local=$RESOLVED_COMMIT_IS_LOCAL
        shift 2
        ;;

      -*)
        fail "unknown option: $1"
        ;;
      *)
        # Non-option argument is treated as context
        contexts+=("$1")
        shift
        ;;
    esac
  done

  # Signing off on a named commit says nothing about the worktree, but the
  # commit itself still has to have made it to a remote
  if ! $force; then
    if [[ -z "$commit" ]]; then
      is_clean || fail "$UNCLEAN_REASON"
    elif ! $commit_is_local; then
      fail "cannot verify ${commit} is on a remote (not a local object; -f to override)"
    elif ! commit_is_on_a_remote "$commit"; then
      fail "commit ${commit} is not on any remote (-f to override)"
    fi
  fi

  local user
  user=$(git config user.name) || fail "failed to get git user name"
  [[ -z "$user" ]] && fail "git user.name is not set"

  if [[ -z "$commit" ]]; then
    commit=$(git rev-parse HEAD) || fail "failed to get current commit"
  fi

  # If no contexts specified, use default
  if [ ${#contexts[@]} -eq 0 ]; then
    contexts=("")
  fi

  local success=true
  local success_messages=()

  # Process each context
  for context in "${contexts[@]}"; do
    local context_name="signoff"
    if [[ -n "$context" ]]; then
      context_name="signoff/${context}"
    fi

    debug "creating status for commit ${commit} by ${user} with context ${context_name}"

    if gh api \
      --method POST \
      "repos/:owner/:repo/statuses/${commit}" \
      -f state=success \
      -f context="${context_name}" \
      -f "description=${user} signed off" >/dev/null; then

      # Build success message
      if [[ -z "$context" ]]; then
        success_messages+=("${STATUS_SUCCESS} Signed off on ${commit}")
      else
        success_messages+=("${STATUS_SUCCESS} Signed off on ${commit} for ${context}")
      fi
    else
      success=false
      if [[ -z "$context" ]]; then
        echo "${STATUS_FAILURE} Failed to sign off on ${commit}" >&2
      else
        echo "${STATUS_FAILURE} Failed to sign off on ${commit} for ${context}" >&2
      fi
    fi
  done

  # Show success messages if everything passed
  if $success; then
    printf "%s\n" "${success_messages[@]}"
  else
    exit 1
  fi
}

cmd_install() {
  local branch=""
  local contexts=()
  # All arguments except --branch are contexts

  # Process arguments with proper option handling
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        if [[ -z "${2:-}" || "$2" == -* ]]; then
          fail "option --branch requires an argument"
        fi
        branch="$2"
        shift 2
        ;;
      -f)
        fail "-f is only valid for create"
        ;;
      --commit)
        fail "--commit is only valid for create and status"
        ;;
      -*)
        fail "unknown option: $1"
        ;;
      *)
        # All positional arguments are contexts
        contexts+=("$1")
        shift
        ;;
    esac
  done

  # Ruleset identity hinges on whether the branch is the default, so resolve
  # the default branch in this shell before deriving anything from it — even
  # when --branch was given
  require_default_branch
  if [[ -z "$branch" ]]; then
    branch="$DEFAULT_BRANCH"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Default to standard signoff if no contexts specified
  if [ ${#contexts[@]} -eq 0 ]; then
    contexts=("")
  fi

  # The requested contexts by their full status-check names
  local requested="" context context_name
  for context in "${contexts[@]}"; do
    context_name="signoff"
    if [[ -n "$context" ]]; then
      context_name="signoff/${context}"
    fi
    requested="${requested:+$requested$'\n'}$context_name"
  done

  # A failed listing must be fatal here: proceeding would POST a duplicate of
  # a ruleset the listing merely failed to see
  find_signoff_ruleset_id "$branch" || fail "failed to list rulesets"

  local existing=""
  if [[ -n "$SIGNOFF_RULESET_ID" ]]; then
    existing=$(signoff_ruleset_contexts "$SIGNOFF_RULESET_ID") ||
      fail "failed to read signoff ruleset"
  fi

  # Fatal on an indeterminate read: migrating from protection we never
  # actually saw could drop its contexts from the union
  legacy_protection_disposition "$branch" || fail "failed to read branch protection"

  # Additive union: what our ruleset already requires, what legacy protection
  # still requires, and what this invocation asks for
  merge_contexts "$existing" "$LEGACY_SIGNOFF_CONTEXTS" "$requested"

  local union=() line
  while read -r line; do
    if [[ -n "$line" ]]; then
      union+=("$line")
    fi
  done <<<"$MERGED_CONTEXTS"

  debug "installing signoff ruleset on branch: ${branch} with ${#union[@]} contexts"

  write_signoff_ruleset "$branch" "$SIGNOFF_RULESET_ID" "${union[@]}"

  # Output success messages
  if [ ${#contexts[@]} -eq 1 ] && [ -z "${contexts[0]}" ]; then
    echo "${STATUS_SUCCESS} GitHub ${branch} branch now requires signoff"
  else
    for context in "${contexts[@]}"; do
      if [[ -z "$context" ]]; then
        echo "${STATUS_SUCCESS} GitHub ${branch} branch now requires signoff"
      else
        echo "${STATUS_SUCCESS} GitHub ${branch} branch now requires signoff on ${context}"
      fi
    done
  fi

  # The ruleset now carries every legacy signoff context, so their legacy
  # enforcement is redundant and gets retired. Warn rather than fail on a
  # cleanup error: enforcement already moved, a leftover is a duplicate.
  if retire_legacy_signoff "$branch"; then
    if [[ "$LEGACY_PROTECTION" == "signoff" ]]; then
      echo "${STATUS_SUCCESS} Migrated legacy branch protection to a ruleset"
    elif [[ -n "$LEGACY_SIGNOFF_CONTEXTS" ]]; then
      echo "${STATUS_SUCCESS} Migrated legacy signoff contexts to a ruleset"
    fi
  else
    echo "Warning: could not remove signoff from legacy branch protection on ${branch}; the ruleset now enforces it, so remove the legacy signoff contexts in repo settings" >&2
  fi
}

cmd_uninstall() {
  local branch=""
  local contexts=()
  # All arguments except --branch are contexts

  # Process arguments with option handling
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        if [[ -z "${2:-}" || "$2" == -* ]]; then
          fail "option --branch requires an argument"
        fi
        branch="$2"
        shift 2
        ;;
      -f)
        fail "-f is only valid for create"
        ;;
      --commit)
        fail "--commit is only valid for create and status"
        ;;
      -*)
        fail "unknown option: $1"
        ;;
      *)
        # All positional arguments are contexts. An empty one would slip past
        # the bare-vs-contextual split below and quietly subtract nothing
        # while claiming the whole requirement removed.
        [[ -n "$1" ]] || fail "context name cannot be empty"
        contexts+=("$1")
        shift
        ;;
    esac
  done

  # As in install: ruleset identity needs the default branch known, even when
  # --branch was given
  require_default_branch
  if [[ -z "$branch" ]]; then
    branch="$DEFAULT_BRANCH"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Bare uninstall removes the whole requirement; contextual subtracts
  local bare=false
  if [ ${#contexts[@]} -eq 0 ]; then
    bare=true
    contexts=("")
  fi

  # As in install: acting on a listing that failed could orphan or duplicate
  # the ruleset, so bail instead
  find_signoff_ruleset_id "$branch" || fail "failed to list rulesets"

  # Fatal on an indeterminate read: "removed" claims below hinge on knowing
  # what legacy protection enforces, and a 403/500 is not "nothing"
  legacy_protection_disposition "$branch" || fail "failed to read branch protection"

  local migration_note=""

  if $bare; then
    local removed=false
    if [[ -n "$SIGNOFF_RULESET_ID" ]]; then
      debug "deleting signoff ruleset ${SIGNOFF_RULESET_ID} for branch: ${branch}"
      delete_signoff_ruleset "$SIGNOFF_RULESET_ID"
      removed=true
    fi
    if [[ "$LEGACY_PROTECTION" == "signoff" || -n "$LEGACY_SIGNOFF_CONTEXTS" ]]; then
      removed=true
    fi
    # Unlike install, a failed legacy cleanup here is fatal: reporting the
    # requirement removed while legacy protection still enforces it would be
    # a lie, and rerunning uninstall retries idempotently
    retire_legacy_signoff "$branch" ||
      fail "failed to remove signoff from legacy branch protection on ${branch}"
    $removed || fail "no signoff requirement installed on ${branch}"
  else
    # Everything currently required, from our ruleset and legacy protection
    local existing=""
    if [[ -n "$SIGNOFF_RULESET_ID" ]]; then
      existing=$(signoff_ruleset_contexts "$SIGNOFF_RULESET_ID") ||
        fail "failed to read signoff ruleset"
    fi
    merge_contexts "$existing" "$LEGACY_SIGNOFF_CONTEXTS"
    local available="$MERGED_CONTEXTS"

    if [[ -z "$available" ]]; then
      fail "no signoff requirement installed on ${branch}"
    fi

    local requested="" remaining="" context line
    for context in "${contexts[@]}"; do
      requested="${requested:+$requested$'\n'}signoff/${context}"
    done

    while read -r line; do
      if [[ $'\n'"$requested"$'\n' != *$'\n'"${line}"$'\n'* ]]; then
        remaining="${remaining:+$remaining$'\n'}$line"
      fi
    done <<<"$available"

    if [[ -n "$remaining" ]]; then
      # Write the remainder — creating the ruleset when the contexts lived
      # only in legacy protection, so contextual uninstall migrates too
      local keep=()
      while read -r line; do
        keep+=("$line")
      done <<<"$remaining"
      debug "keeping ${#keep[@]} signoff contexts on branch: ${branch}"
      write_signoff_ruleset "$branch" "$SIGNOFF_RULESET_ID" "${keep[@]}"
      if [[ "$LEGACY_PROTECTION" == "signoff" ]]; then
        migration_note="${STATUS_SUCCESS} Migrated legacy branch protection to a ruleset"
      elif [[ -n "$LEGACY_SIGNOFF_CONTEXTS" ]]; then
        migration_note="${STATUS_SUCCESS} Migrated legacy signoff contexts to a ruleset"
      fi
    elif [[ -n "$SIGNOFF_RULESET_ID" ]]; then
      # The last context is going away: no empty ruleset left behind
      debug "deleting signoff ruleset ${SIGNOFF_RULESET_ID} for branch: ${branch}"
      delete_signoff_ruleset "$SIGNOFF_RULESET_ID"
    fi
    # Fatal, as in the bare case: the contexts just uninstalled may live in
    # legacy protection too, and a failed removal there keeps enforcing them
    retire_legacy_signoff "$branch" ||
      fail "failed to remove signoff from legacy branch protection on ${branch}"
  fi

  # Output success messages
  if [ ${#contexts[@]} -eq 1 ] && [ -z "${contexts[0]}" ]; then
    echo "${STATUS_SUCCESS} GitHub ${branch} branch no longer requires signoff"
  else
    for context in "${contexts[@]}"; do
      if [[ -z "$context" ]]; then
        echo "${STATUS_SUCCESS} GitHub ${branch} branch no longer requires signoff"
      else
        echo "${STATUS_SUCCESS} GitHub ${branch} branch no longer requires signoff on ${context}"
      fi
    done
  fi

  if [[ -n "$migration_note" ]]; then
    echo "$migration_note"
  fi
}

cmd_check() {
  local branch=""
  local contexts=()
  # All arguments except --branch are contexts

  # Process arguments with option handling
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        if [[ -z "${2:-}" || "$2" == -* ]]; then
          fail "option --branch requires an argument"
        fi
        branch="$2"
        shift 2
        ;;
      -f)
        fail "-f is only valid for create"
        ;;
      --commit)
        fail "--commit is only valid for create and status"
        ;;
      -*)
        fail "unknown option: $1"
        ;;
      *)
        # All positional arguments are contexts
        contexts+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    branch=$(default_branch) || fail "failed to get default branch"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Default to standard signoff if no contexts specified
  if [ ${#contexts[@]} -eq 0 ]; then
    contexts=("")
  fi

  # Fetch the required contexts once, one per line
  fetch_required_signoff_contexts "$branch"

  if [[ -z "$SIGNOFF_CONTEXTS" ]]; then
    for context in "${contexts[@]}"; do
      if [[ -z "$context" ]]; then
        echo "${STATUS_FAILURE} GitHub ${branch} branch does not require signoff"
      else
        echo "${STATUS_FAILURE} GitHub ${branch} branch does not require signoff on ${context}"
      fi
    done
    exit 1
  fi

  if $SIGNOFF_LEGACY_PRESENT; then
    legacy_upgrade_hint
  fi

  # Check each context
  for context in "${contexts[@]}"; do
    local context_name="signoff"
    if [[ -n "$context" ]]; then
      context_name="signoff/${context}"
    fi

    debug "checking protection for branch: ${branch} with context: ${context_name}"

    # Whole-line match, so 'signoff' isn't satisfied by 'signoff/tests'
    if [[ $'\n'"$SIGNOFF_CONTEXTS"$'\n' == *$'\n'"${context_name}"$'\n'* ]]; then
      if [[ -z "$context" ]]; then
        echo "${STATUS_SUCCESS} GitHub ${branch} branch requires signoff"
      else
        echo "${STATUS_SUCCESS} GitHub ${branch} branch requires signoff on ${context}"
      fi
    else
      if [[ -z "$context" ]]; then
        echo "${STATUS_FAILURE} GitHub ${branch} branch does not require signoff"
      else
        echo "${STATUS_FAILURE} GitHub ${branch} branch does not require signoff on ${context}"
      fi
    fi
  done
}

cmd_status() {
  local branch=""
  local commit=""

  # Process arguments with option handling
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        if [[ -z "${2:-}" || "$2" == -* ]]; then
          fail "option --branch requires an argument"
        fi
        branch="$2"
        shift 2
        ;;
      --commit)
        resolve_commit "${2:-}"
        commit="$RESOLVED_COMMIT"
        shift 2
        ;;
      -f)
        fail "-f is only valid for create"
        ;;
      -*)
        fail "unknown option: $1"
        ;;
      *)
        # For now we don't support filtering by context
        fail "unexpected argument: $1"
        ;;
    esac
  done

  # If branch not specified, use default branch
  if [[ -z "$branch" ]]; then
    branch=$(default_branch) || fail "failed to get default branch"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Default to the current commit
  if [[ -z "$commit" ]]; then
    commit=$(git rev-parse HEAD) || fail "failed to get current commit"
  fi

  # Get the signoff statuses on this commit as context/state pairs. A filter
  # error surfaces here rather than silently rendering every context as failed.
  local statuses
  statuses=$(gh api "repos/:owner/:repo/commits/${commit}/status" \
    --jq '.statuses[]? | select(.context? | . == "signoff" or startswith("signoff/")) | [.context, .state] | @tsv' \
    2>/dev/null) || {
    echo "${STATUS_FAILURE} Could not get status for commit ${commit}"
    exit 1
  }
  statuses=${statuses//$'\r'/}

  # Create required contexts list - always start with "signoff"
  local required=("signoff")

  # Add any additional required contexts from our ruleset and legacy protection
  fetch_required_signoff_contexts "$branch"

  if $SIGNOFF_LEGACY_PRESENT; then
    legacy_upgrade_hint
  fi

  local ctx
  while read -r ctx; do
    [[ -z "$ctx" || "$ctx" == "signoff" ]] && continue  # Skip empty or default signoff (already included)
    required+=("$ctx")
  done <<< "$SIGNOFF_CONTEXTS"

  # Map contexts to states as "context1=state1;context2=state2;..."
  # A lightweight stand-in for associative arrays, which Bash 3 lacks
  local context_map="" context state found req
  while IFS=$'\t' read -r context state; do
    [[ -z "$context" ]] && continue
    context_map="${context_map}${context}=${state};"

    # Show contexts that were signed off even if protection doesn't require them
    found=false
    for req in "${required[@]}"; do
      [[ "$req" == "$context" ]] && { found=true; break; }
    done
    $found || required+=("$context")
  done <<< "$statuses"

  # Generate status output for all contexts (required + actual)
  local all_results=()
  for context in "${required[@]}"; do
    local display_name="$context"
    [[ "$context" == "signoff/"* ]] && display_name="${context#signoff/}"
    [[ "$context" == "signoff" ]] && display_name="signoff"

    # Check if we have a successful status for this context
    # by looking for "context=success;" in our map
    if [[ "$context_map" == *"${context}=success;"* ]]; then
      all_results+=("${STATUS_SUCCESS} $display_name")
    else
      all_results+=("${STATUS_FAILURE} $display_name")
    fi
  done

  # Print all results
  printf "%s\n" "${all_results[@]}"
}

cmd_completion() {
  # Check if --contexts flag is passed
  if [[ "${1:-}" == "--contexts" ]]; then
    shift
    reject_extra_args "$@"
    get_signoff_contexts
    return
  fi
  reject_extra_args "$@"

  cat <<'EOF'
# bash completion for gh signoff

_gh_signoff_contexts() {
  # Get dynamic contexts from branch protection
  contexts=$(gh signoff completion --contexts 2>/dev/null)
  echo "$contexts"
}

# The first word that is neither a global option nor its argument. -f and
# --commit may precede the command, so COMP_WORDS[1] is not it. Stops short of
# the word being completed: that one is what the user is still typing, not a
# command they have settled on, and echoing it back would suppress the very
# list they are typing towards. Empty means the cursor is at the command.
_gh_signoff_command() {
  local i=1
  while [[ $i -lt $COMP_CWORD ]]; do
    case "${COMP_WORDS[$i]}" in
      -f)       i=$((i+1)) ;;
      --commit) i=$((i+2)) ;;
      *)        echo "${COMP_WORDS[$i]}"; return ;;
    esac
  done
}

_gh_signoff() {
  local cur prev command
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  case "$prev" in
    signoff)
      # Include dynamic contexts in top-level completion
      local contexts=$(_gh_signoff_contexts)
      COMPREPLY=( $(compgen -W "create install uninstall check status version -f --commit --help $contexts" -- "$cur") )
      return 0
      ;;
    --commit)
      # A revision. Nothing worth guessing at.
      return 0
      ;;
    -f)
      # A leading -f may be followed by the create command, --commit or a
      # context; elsewhere only contexts remain
      local contexts=$(_gh_signoff_contexts)
      if [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "create --commit $contexts" -- "$cur") )
      else
        COMPREPLY=( $(compgen -W "$contexts" -- "$cur") )
      fi
      return 0
      ;;
    create)
      local contexts=$(_gh_signoff_contexts)
      COMPREPLY=( $(compgen -W "-f --commit $contexts" -- "$cur") )
      return 0
      ;;
    status)
      COMPREPLY=( $(compgen -W "--branch --commit" -- "$cur") )
      return 0
      ;;
    install|uninstall|check)
      local contexts=$(_gh_signoff_contexts)
      COMPREPLY=( $(compgen -W "--branch $contexts" -- "$cur") )
      return 0
      ;;
  esac

  command=$(_gh_signoff_command)

  # If we are halfway through typing an option
  if [[ $cur == --* ]]; then
    case "$command" in
      install|uninstall|check)
        COMPREPLY=( $(compgen -W "--branch" -- "$cur") )
        ;;
      status)
        COMPREPLY=( $(compgen -W "--branch --commit" -- "$cur") )
        ;;
      *)
        COMPREPLY=( $(compgen -W "--commit" -- "$cur") )
        ;;
    esac
    return 0
  fi

  # No command yet, so the cursor is where one goes: offer the same list as
  # directly after `signoff`, which a leading -f or --commit would otherwise
  # push out of reach
  if [[ -z "$command" ]]; then
    local contexts=$(_gh_signoff_contexts)
    COMPREPLY=( $(compgen -W "create install uninstall check status version -f --commit --help $contexts" -- "$cur") )
    return 0
  fi

  # For partial signoffs, suggest context names
  if [[ $COMP_CWORD -gt 1 && "$command" != "install" &&
        "$command" != "uninstall" && "$command" != "check" &&
        "$command" != "status" && "$command" != "version" &&
        "$command" != "completion" && "$command" != "--help" &&
        "$command" != "-h" ]]; then
    local contexts=$(_gh_signoff_contexts)
    COMPREPLY=( $(compgen -W "$contexts" -- "$cur") )
    return 0
  fi

  return 0
}

complete -F _gh_signoff gh-signoff
EOF
}

cmd_version() {
  echo "gh-signoff ${VERSION}"
}

cmd_help() {
  cat <<'EOF'
Sign off on commits without CI infrastructure.

USAGE
  gh signoff [flags] [command] [options]

COMMANDS
  create (default) Sign off on the current commit or a specific commit
  install          Require signoff via a repository ruleset. Adds the given
                   contexts to whatever is already required, and migrates any
                   legacy signoff branch protection into the ruleset
  uninstall        Remove the signoff requirement — or, given contexts, remove
                   just those and keep the rest
  check            Check if signoff is required
  status           Show signoff status for the current commit or a specific commit
  version          Show gh-signoff version
  completion       Output shell completion code

FLAGS
  -f  Force sign off (ignore uncommitted/unpushed changes)

OPTIONS
  --branch <branch>  Branch to operate on (for install, uninstall, check, status)
  --commit <sha>     Commit to sign off on (for create, status). Any revision
                     git resolves; must be on a remote unless forced with -f

EXAMPLES
  gh signoff                           # Sign off on current commit
  gh signoff --commit abc1234          # Sign off on a specific commit
  gh signoff --commit HEAD~1 tests     # Partial signoff on a specific commit
  gh signoff create -f                 # Force signoff
  gh signoff install                   # Require signoff on default branch
  gh signoff install --branch other    # Require signoff on a specific branch
  gh signoff install tests lint        # Also require signoff on tests and lint
  gh signoff uninstall tests           # Stop requiring signoff on tests only
  gh signoff check                     # Check if signoff is required
  gh signoff check --branch other      # Check if signoff is required on branch
  gh signoff status                    # Show completed/pending signoff status
  gh signoff status --commit abc1234   # Show status for a specific commit

COMPLETION
  # Add to ~/.bashrc:
  eval "$(gh signoff completion)"
EOF
}

# A leading -f applies to create (explicit, implicit, or contextual); a leading
# --commit to create and status. Both are rejected for every other command.
#
# The revision stays raw here: resolving it before the command is known would
# report `gh signoff --commit nope install` as a bad revision, when what's
# actually wrong is that install takes no --commit at all.
force=""
commit_opt=()
while :; do
  case "${1:-}" in
    -f)
      force="-f"
      shift
      ;;
    --commit)
      [[ -n "${2:-}" && "$2" != -* ]] || fail "option --commit requires an argument"
      commit_opt=(--commit "$2")
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

reject_force() {
  if [[ -n "$force" ]]; then
    fail "-f is only valid for create"
  fi
}

reject_commit() {
  if [[ ${#commit_opt[@]} -gt 0 ]]; then
    fail "--commit is only valid for create and status"
  fi
}

# ${commit_opt[@]+"${commit_opt[@]}"} is the Bash 3 set -u safe expansion of a
# possibly-empty array. ${commit_opt:+...} would word-split the revision.
case "${1:-}" in
  "")               cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} ;;
  "create")         shift; cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} "$@" ;;
  "install")        reject_force; reject_commit; shift; cmd_install "$@" ;;
  "uninstall")      reject_force; reject_commit; shift; cmd_uninstall "$@" ;;
  "check")          reject_force; reject_commit; shift; cmd_check "$@" ;;
  "status")         reject_force; shift; cmd_status ${commit_opt[@]+"${commit_opt[@]}"} "$@" ;;
  "version")        reject_force; reject_commit; reject_extra_args "${@:2}"; cmd_version ;;
  "completion")     reject_force; reject_commit; shift; cmd_completion "$@" ;;
  "-h" | "--help")  reject_force; reject_commit; reject_extra_args "${@:2}"; cmd_help ;;
  -*)
    # Unknown option
    cmd_help; exit 1
    ;;
  *)
    # Treat as partial signoff context(s)
    cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} "$@"
    ;;
esac
