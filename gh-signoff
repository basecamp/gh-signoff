        # and uninstall. A read composes a lookup key by quoting too, so the
        # quote/backslash/C0 rejection keeps that key valid.
        require_context_name "context name" "$1"
        contexts+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$branch" ]]; then
    branch=$(default_branch) || fail "failed to get default branch"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Messages show the scrubbed branch name; every path that talks to GitHub
  # keeps the raw one. A branch is named by the repository, not by us, so it
  # is only held to the JSON rule — but it still prints to a terminal.
  local branch_shown
  branch_shown=$(scrub "$branch")

  # Default to standard signoff if no contexts specified
  if [ ${#contexts[@]} -eq 0 ]; then
    contexts=("")
  fi

  # Fetch the required contexts once, one per line
  fetch_required_signoff_contexts "$branch"

  if [[ -z "$SIGNOFF_CONTEXTS" ]]; then
    for context in "${contexts[@]}"; do
      if [[ -z "$context" ]]; then
        printf '%s\n' "${STATUS_FAILURE} GitHub ${branch_shown} branch does not require signoff"
      else
        printf '%s\n' "${STATUS_FAILURE} GitHub ${branch_shown} branch does not require signoff on $(scrub "$context")"
      fi
    done
    exit 1
  fi

  if $SIGNOFF_LEGACY_PRESENT; then
    legacy_upgrade_hint
  fi

  # Check each context
  for context in "${contexts[@]}"; do
    local context_name="signoff"
    if [[ -n "$context" ]]; then
      context_name="signoff/${context}"
    fi

    debug "checking protection for branch: $(scrub "$branch") with context: ${context_name}"

    # Whole-key match — the key runs to the record's tab — so 'signoff' isn't
    # satisfied by 'signoff/tests', while 'signoff/Tests' does satisfy it
    if [[ $'\n'"$SIGNOFF_CONTEXTS" == *$'\n'"$(context_key "$context_name")"$'\t'* ]]; then
      if [[ -z "$context" ]]; then
        printf '%s\n' "${STATUS_SUCCESS} GitHub ${branch_shown} branch requires signoff"
      else
        printf '%s\n' "${STATUS_SUCCESS} GitHub ${branch_shown} branch requires signoff on $(scrub "$context")"
      fi
    else
      if [[ -z "$context" ]]; then
        printf '%s\n' "${STATUS_FAILURE} GitHub ${branch_shown} branch does not require signoff"
      else
        printf '%s\n' "${STATUS_FAILURE} GitHub ${branch_shown} branch does not require signoff on $(scrub "$context")"
      fi
    fi
  done
}

cmd_status() {
  local branch=""
  local commit=""

  # Process arguments with option handling
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch)
        if [[ -z "${2:-}" || "$2" == -* ]]; then
          fail "option --branch requires an argument"
        fi
        branch="$2"
        shift 2
        ;;
      --commit)
        resolve_commit "${2:-}"
        commit="$RESOLVED_COMMIT"
        shift 2
        ;;
      -f)
        fail "-f is only valid for create"
        ;;
      -*)
        fail "unknown option: $(scrub "$1")"
        ;;
      *)
        # For now we don't support filtering by context
        fail "unexpected argument: $(scrub "$1")"
        ;;
    esac
  done

  # If branch not specified, use default branch
  if [[ -z "$branch" ]]; then
    branch=$(default_branch) || fail "failed to get default branch"
  fi
  [[ -z "$branch" ]] && fail "branch name cannot be empty"

  # Default to the current commit
  if [[ -z "$commit" ]]; then
    commit=$(git rev-parse HEAD) || fail "failed to get current commit"
  fi

  # Get the signoff statuses on this commit as context records with their
  # state appended. A state rides along raw rather than as a token of its
  # own, so it is held to GitHub's documented closed enum first and anything
  # else becomes "unknown" — a state is not a name, and one carrying a tab or
  # a newline could otherwise spell a record of its own making. Mapping
  # rather than dropping keeps a context with a strange state visible, as the
  # failure it is. A filter error surfaces here rather than silently
  # rendering every context as failed. The namespace test folds case, so a
  # SignOff status is recognized as the signoff it is.
  local statuses
  statuses=$(gh api "repos/:owner/:repo/commits/${commit}/status" \
    --jq ".statuses[]? | select(((.context? // \"\") | ascii_downcase) | (. == \"signoff\" or startswith(\"signoff/\"))) | (if (.state == \"error\" or .state == \"failure\" or .state == \"pending\" or .state == \"success\") then .state else \"unknown\" end) as \$state | .context | ${CONTEXT_RECORD_JQ} + \"\t\" + \$state" \
    2>/dev/null) || {
    printf '%s\n' "${STATUS_FAILURE} Could not get status for commit ${commit}"
    exit 1
  }
  statuses=${statuses//$'\r'/}

  # Create required contexts list - always start with "signoff"
  local required
  required=("$(context_record "signoff")")

  # Add any additional required contexts from our ruleset and legacy protection
  fetch_required_signoff_contexts "$branch"

  if $SIGNOFF_LEGACY_PRESENT; then
    legacy_upgrade_hint
  fi

  local key token display
  while IFS=$'\t' read -r key token display; do
    # Skip empty or default signoff, however spelled: already included
    [[ -z "$key" || "$key" == '"signoff"' ]] && continue
    required+=("${key}"$'\t'"${token}"$'\t'"${display}")
  done <<< "$SIGNOFF_CONTEXTS"

  # Map contexts to states as newline-delimited "key=state" records.
  # A lightweight stand-in for associative arrays, which Bash 3 lacks.
  # Records are matched whole-line below: a delimiter-free concatenation
  # would let 'signoff/foo-signoff=success' satisfy a lookup for plain
  # 'signoff=success' by substring.
  local context_map="" state found req
  while IFS=$'\t' read -r key token display state; do
    [[ -z "$key" ]] && continue
    context_map="${context_map}${key}=${state}"$'\n'

    # Show contexts that were signed off even if protection doesn't require them
    found=false
    for req in "${required[@]}"; do
      [[ "${req%%$'\t'*}" == "$key" ]] && { found=true; break; }
    done
    $found || required+=("${key}"$'\t'"${token}"$'\t'"${display}")
  done <<< "$statuses"

  # Generate status output for all contexts (required + actual). What prints
  # is the record's display field: the name in the display alphabet, with
  # everything outside printable ASCII shown as a question mark, so an adopted
  # context cannot reorder or repaint the line it appears on.
  local all_results=() display_name
  for req in "${required[@]}"; do
    key="${req%%$'\t'*}"
    display_name="${req##*$'\t'}"
    [[ "$key" == '"signoff/'* ]] && display_name="${display_name:8}"

    # Check if we have a successful status for this context: whole-record
    # match, so no other context's record can stand in for it
    if [[ $'\n'"$context_map" == *$'\n'"${key}=success"$'\n'* ]]; then
      all_results+=("${STATUS_SUCCESS} $display_name")
    else
      all_results+=("${STATUS_FAILURE} $display_name")
    fi
  done

  # Print all results
  printf "%s\n" "${all_results[@]}"
}

cmd_version() {
  echo "gh-signoff ${VERSION}"
}

cmd_help() {
  cat <<'EOF'
Sign off on commits without CI infrastructure.

USAGE
  gh signoff [flags] [command] [options]

COMMANDS
  create (default) Sign off on the current commit or a specific commit
  install          Require signoff via a repository ruleset. Adds the given
                   contexts to whatever is already required, and migrates any
                   legacy signoff branch protection into the ruleset
  uninstall        Remove the signoff requirement — or, given contexts, remove
                   just those and keep the rest
  check            Check if signoff is required
  status           Show signoff status for the current commit or a specific commit
  version          Show gh-signoff version

FLAGS
  -f  Force sign off (ignore uncommitted/unpushed changes)

OPTIONS
  --branch <branch>  Branch to operate on (for install, uninstall, check, status)
  --commit <sha>     Commit to sign off on (for create, status). Any revision
                     git resolves; must be on a remote unless forced with -f

EXAMPLES
  gh signoff                           # Sign off on current commit
  gh signoff --commit abc1234          # Sign off on a specific commit
  gh signoff --commit HEAD~1 tests     # Partial signoff on a specific commit
  gh signoff create -f                 # Force signoff
  gh signoff install                   # Require signoff on default branch
  gh signoff install --branch other    # Require signoff on a specific branch
  gh signoff install tests lint        # Also require signoff on tests and lint
  gh signoff uninstall tests           # Stop requiring signoff on tests only
  gh signoff check                     # Check if signoff is required
  gh signoff check --branch other      # Check if signoff is required on branch
  gh signoff status                    # Show completed/pending signoff status
  gh signoff status --commit abc1234   # Show status for a specific commit
EOF
}

# A leading -f applies to create (explicit, implicit, or contextual); a leading
# --commit to create and status. Both are rejected for every other command.
#
# The revision stays raw here: resolving it before the command is known would
# report `gh signoff --commit nope install` as a bad revision, when what's
# actually wrong is that install takes no --commit at all.
force=""
commit_opt=()
while :; do
  case "${1:-}" in
    -f)
      force="-f"
      shift
      ;;
    --commit)
      [[ -n "${2:-}" && "$2" != -* ]] || fail "option --commit requires an argument"
      commit_opt=(--commit "$2")
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

reject_force() {
  if [[ -n "$force" ]]; then
    fail "-f is only valid for create"
  fi
}

reject_commit() {
  if [[ ${#commit_opt[@]} -gt 0 ]]; then
    fail "--commit is only valid for create and status"
  fi
}

# No positional at all is the bare default signoff; an explicitly-passed
# first positional, even an empty string, is a context to validate. Matching
# on "${1:-}" alone conflated the two, so `gh signoff -f '' good` took the
# bare-default path and silently dropped both arguments. Split on $# instead:
# only a truly empty argument list defaults, and everything else — the empty
# string included — reaches cmd_create, whose grammar check rejects it.
if [[ $# -eq 0 ]]; then
  cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"}
  exit 0
fi

# ${commit_opt[@]+"${commit_opt[@]}"} is the Bash 3 set -u safe expansion of a
# possibly-empty array. ${commit_opt:+...} would word-split the revision.
case "$1" in
  "create")         shift; cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} "$@" ;;
  "install")        reject_force; reject_commit; shift; cmd_install "$@" ;;
  "uninstall")      reject_force; reject_commit; shift; cmd_uninstall "$@" ;;
  "check")          reject_force; reject_commit; shift; cmd_check "$@" ;;
  "status")         reject_force; shift; cmd_status ${commit_opt[@]+"${commit_opt[@]}"} "$@" ;;
  "version")        reject_force; reject_commit; reject_extra_args "${@:2}"; cmd_version ;;
  "completion")
    # Tombstone for a removed command. Completion never worked through
    # `gh signoff` (see the removal commit), but the setup line we published,
    # `eval "$(gh signoff completion)"`, lives on in users' shell startup
    # files. With the command gone, `completion` is just a context name and
    # would fall through to direct signoff below — so that stale eval line
    # would POST a false signoff/completion status in any clean, pushed repo,
    # then try to run the "✓ Signed off" sentence it captured as a command.
    #
    # Intercept it ahead of the fallback: make no API call, say NOTHING on
    # stdout (eval runs whatever stdout carries, and empty is a safe no-op, so
    # no "✓: command not found"), explain on stderr, and exit nonzero. This
    # fires whatever leading -f/--commit was parsed, which is why it does not
    # bother with reject_force/reject_commit. `gh signoff create completion`
    # still reaches the create arm above and signs off the literal context,
    # for anyone who truly wants it.
    printf '%s\n' "gh-signoff: shell completion has been removed; it never worked through 'gh signoff'." >&2
    printf '%s\n' "Remove this line from your shell startup file (e.g. ~/.bashrc): eval \"\$(gh signoff completion)\"" >&2
    exit 1
    ;;
  "-h" | "--help")  reject_force; reject_commit; reject_extra_args "${@:2}"; cmd_help ;;
  "--")
    # End of options routes to implicit create, so `gh signoff -- -qa` signs
    # off a leading-dash context directly. The -- is passed through (no shift):
    # cmd_create's own end-of-options handler consumes it and treats the rest
    # as contexts.
    cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} "$@" ;;
  -*)
    # Unknown option
    cmd_help; exit 1
    ;;
  *)
    # Treat as partial signoff context(s)
    cmd_create ${force:+-f} ${commit_opt[@]+"${commit_opt[@]}"} "$@"
    ;;
esac
